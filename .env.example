# Copy this file to .env and fill in your keys (optional - the analyzer works without them).

# https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
# https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GSB_API_KEY=

# Allow SSL checks against private/internal IPs (keep false when exposed publicly - SSRF guard)
ALLOW_PRIVATE_TARGETS=false
# Overall time budget for network checks, in seconds
TASK_TIMEOUT=20
# Seconds to cache a report for the same URL (0 disables)
CACHE_TTL=300

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
